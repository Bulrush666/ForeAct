# Copy to .env or export these variables in your shell. Do not commit .env.
PYTHON_BIN=/absolute/path/to/foreact-env/bin/python
MODEL_DIR=/absolute/path/to/cosmos2
DATA_ROOT_DIR=/absolute/path/to/lerobot-data-root
DEPTH_CACHE_ROOT=/absolute/path/to/moge3-depth-cache
OUTPUT_ROOT=/absolute/path/to/output-directory

# Optional evaluation/deployment dependencies.
SIM_PYTHON=/absolute/path/to/simpler-env/bin/python
SIMPLER_ENV_ROOT=/absolute/path/to/SimplerEnv
COSMOS2_ACTION_CKPT=/absolute/path/to/action-checkpoint.pt
COSMOS2_MODEL_DIR=/absolute/path/to/cosmos2
MOGE_PY=/absolute/path/to/moge3-env/bin/python
